# Copy to backend/.env. Users choose Gemini or GPT-6 Luna in the frontend.
# Configure both keys to enable both choices. Restart after changing keys.

# OpenAI: https://platform.openai.com/api-keys (API billing required)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-6-luna

# Gemini: https://aistudio.google.com/apikey
# Also required for Skill Coach retrieval embeddings when generating with OpenAI.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Supabase (https://supabase.com/dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Separate daily pools for Gemini and OpenAI (UTC).
# Analysis + Skill Coach attempts share the selected provider's pool.
DAILY_AI_LIMIT=20
GUEST_DAILY_AI_LIMIT=20

# RAG / Skill Coach: the pgvector knowledge base reuses the keys above —
# GEMINI_API_KEY for gemini-embedding-001 embeddings and the SUPABASE_* keys for
# pgvector storage/retrieval. No extra config needed; just run the schema and
# `python -m scripts.ingest_kb` to populate it.

# Failures and cancellations also count toward the selected provider's pool.
# Optional stable secret for hashing guest network addresses. Defaults to the
# service-role key. Use a dedicated secret to keep hashes stable on key rotation.
# QUOTA_HASH_SECRET=...
# Set ENVIRONMENT=production on non-Vercel production deployments.
